{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaioken",
  "version": "1.3.3",
  "identifier": "dev.kaioken.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kaioken",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#080808",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "frame-src": "https: http://localhost:* http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/kaioken-daemon"],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "AI coding agent + knowledge engine",
    "longDescription": "Kaioken scans a repository, generates a deep wiki and task skills, and gives you a tool-using chat agent over the same codebase."
  },
  "plugins": {
    "updater": { "endpoints": [], "pubkey": "" }
  }
}
