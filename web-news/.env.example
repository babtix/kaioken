# Password for the single admin account. Choose something long.
ADMIN_PASSWORD=

# Signing key for session cookies. At least 16 characters; rotate to log
# everyone out. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Redis-compatible KV over REST (Vercel KV or Upstash). Without these the site
# still runs, but posts live in process memory and vanish on a cold start.
KV_REST_API_URL=
KV_REST_API_TOKEN=
