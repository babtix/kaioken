# Build artifacts
cli/kaioken.exe
cli/kaioken.exe.old
cli/kaioken.exe~
cli/kaioken_new.exe
cli/kaioken-new.exe
*.exe
cli/kaioken-test

# GoReleaser output (snapshot and release builds)
/dist/

# Session and state (local-only)
**/.kaioken/sessions/
**/.kaioken/site/
*.tar.gz
.kaioken/config.yaml
.kaioken/research/
.hermes/
.vite/

# Agent tooling (local-only)
.qoder/
.claude/
.ainow/

# Third-party source vendored for reading only, not built or shipped.
# See .reference/README.md for what is here and why.
.reference/

# Full opencode and pi clone at repo root, read-only reference material — not the
# vendored .reference/opencode/ sparse checkout, kept separately because it
# has packages/{llm,app,console,...} that one omits. Never built or shipped;
# ignored so it can't land in a commit by accident (it carries node_modules).
/opencode/
/pi/

# Website
website/node_modules/
website/dist/

# Desktop app
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/src-tauri/gen/
desktop/src-tauri/target/release/bundle/

# OS files
Thumbs.db
.DS_Store

# Nested reference repo with its own .git — not part of this repository, same
# treatment as opencode/. Committing it would create a stray gitlink.
cli/PRISM_RAG/

# The GitHub Wiki, cloned locally for editing (github.com/babtix/kaioken.wiki.git).
# It has its own .git, is pushed to its own remote, and neither site's build reads
# it — tracking it here only produced a gitlink with no .gitmodules to resolve it,
# which is what caused "Failed to fetch one or more git submodules" on every clone.
/wiki/

# web-news
web-news/node_modules/
web-news/dist/
web-news/.vercel/

# Per-repo generated caches. The wiki and knowledge cards are committed on
# purpose — these are not: the search index is a rebuildable derivative that
# churns on every generation, mcp.json embeds an absolute binary path, and the
# MCP bearer token is a credential.
**/.kaioken/search_index.json
**/.kaioken/mcp.json
**/.kaioken/mcp_token
